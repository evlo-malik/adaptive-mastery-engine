{
  "name": "adaptive-mastery-engine",
  "version": "0.1.0",
  "description": "A framework-independent TypeScript engine for uncertainty-aware mastery estimation and memory decay.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "mastery-learning",
    "knowledge-tracing",
    "item-response-theory",
    "spaced-repetition",
    "typescript"
  ],
  "author": "Malik Evloev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evlo-malik/adaptive-mastery-engine.git"
  },
  "bugs": {
    "url": "https://github.com/evlo-malik/adaptive-mastery-engine/issues"
  },
  "homepage": "https://github.com/evlo-malik/adaptive-mastery-engine#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
